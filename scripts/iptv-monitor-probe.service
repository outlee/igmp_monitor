[Unit]
Description=IPTV Monitor Probe Service
After=network.target influxdb.service redis.service
Requires=network.target

[Service]
Type=simple
User=iptv
Group=iptv
WorkingDirectory=/opt/iptv-monitor/probe
Environment="INFLUXDB_URL=http://localhost:8086"
# 建议使用 EnvironmentFile=/opt/iptv-monitor/.env 替代下面硬编码（推荐）
Environment="INFLUXDB_ORG=iptv"
Environment="INFLUXDB_BUCKET=metrics"
Environment="REDIS_URL=redis://localhost:6379"
Environment="SQLITE_PATH=/data/db/iptv.db"
Environment="THUMBNAIL_DIR=/data/thumbnails"
Environment="SIM_VIDEO_DIR=/data/videos"
Environment="WORKER_COUNT=10"
Environment="CHANNELS_PER_WORKER=30"
# 正确启动 Probe（不是 uvicorn）
ExecStart=/usr/bin/python3 -m probe.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
