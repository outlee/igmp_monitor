# InfluxDB 配置
INFLUXDB_PASSWORD=your_secure_password_here
INFLUXDB_TOKEN=your_strong_random_token_here__generate_with_openssl_rand_hex_32
INFLUXDB_ORG=iptv
INFLUXDB_BUCKET=metrics

# 探针服务配置
WORKER_COUNT=10
CHANNELS_PER_WORKER=30

# 端口配置（如果需要修改默认端口）
# FRONTEND_PORT=80
# API_PORT=8000
# INFLUXDB_PORT=8086
# REDIS_PORT=6379
